# PostgreSQL connection pour tests unitaires (base en local)
# Note : si le backend est un Supabase self-hosted, le port exposé sur l'hôte
# est celui du pooler Supavisor, qui exige un user au format <rôle>.<POOLER_TENANT_ID>
# (le service Postgres brut n'est pas exposé sur l'hôte, seul le pooler l'est).
DB_HOST_TEST="localhost"
DB_PORT_TEST=5432
DB_NAME_TEST="cardioanalysis_database_test"
DB_USER_TEST="user_test"
DB_PASSWORD_TEST="password_test"

# PostgreSQL connection
DB_HOST="HOST"
DB_PORT=5432
DB_NAME="cardioanalysis_database"
DB_USER="user"
DB_PASSWORD="password"

# Supabase Auth — vérification des JWT (voir app/auth/dependency.py).
# SUPABASE_URL = URL de l'API gateway du stack Supabase self-hosted ciblé.
# SUPABASE_JWT_SECRET = valeur JWT_SECRET du .env de ce stack.
# Pour faire tourner l'app en local en pointant sur un autre backend
# (ex. le NAS) : `ENV_FILE=.env.nas uvicorn app.main:app --reload`
# — voir DEV_RULES.md, section "Modes de connexion locaux".
SUPABASE_URL="http://localhost:8000"
SUPABASE_JWT_SECRET="your-super-secret-jwt-token-with-at-least-32-characters-long"